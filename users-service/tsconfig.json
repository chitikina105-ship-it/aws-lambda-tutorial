{
  "compilerOptions": {
    "types": [
      "node",
      "aws-lambda"
    ],
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "users-crud-lambda/src",
    "skipLibCheck": true
  },
  "include": [
    "users-crud-lambda/src/**/*.ts"
  ]
}